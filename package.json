{
  "name": "coworking-space-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema que gerencia as alocações das salas de um coworking",
  "scripts": {
    "dev": "npm run dev --prefix backend",
    "dev:front": "npm run dev --prefix frontend",
    "start": "npm start --prefix backend",
    "db:generate": "npm run db:generate --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:studio": "npm run db:studio --prefix backend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dante-alves/coworking-space-manager.git"
  },
  "license": "ISC"
}
