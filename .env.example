# Banco (Prisma Postgres)
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Redis (Upstash) — URL TCP com TLS (rediss://)
REDIS_URL=rediss://default:password@host.upstash.io:6379

# JWT
JWT_SECRET=troque_por_um_secret_forte
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_SECONDS=604800

# CORS + cookie (URL exata do front, sem barra no final)
FRONTEND_URL=http://localhost:5173

# Produção (Render) — descomente
# NODE_ENV=production

# Opcional — porta local (Render define PORT automaticamente)
# PORT=3000

# Seed do administrador (npm run db:seed) — opcional
ADMIN_EMAIL=admin@coworking.com
ADMIN_SEED_PASSWORD=Admin123! # defina senha forte
ADMIN_NOME=Administrador
ADMIN_CPF=00000000001
ADMIN_TELEFONE=83999990000
